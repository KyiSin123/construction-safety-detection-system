OPENAI_API_KEY=your_openai_api_key
OPENAI_VISION_MODEL=gpt-4o-mini
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ppe_detection
# Path to a downloaded CA certificate, only needed for managed hosts (e.g. Aiven) that you
# want to verify rather than just encrypt. Leave unset to still connect over TLS unverified.
MYSQL_SSL_CA=
FLASK_SECRET_KEY=replace_with_a_long_random_secret
FLASK_HOST=0.0.0.0
FLASK_PORT=3333
FLASK_DEBUG=true
# Set to false on a cloud deployment with no camera attached -- swaps the home page's
# live-stream controls for the upload-based /api/analyze UI instead.
CAMERA_AVAILABLE=true
# Use a mounted persistent-disk path in cloud deployments, for example
# /var/data/snapshots on Render. Local/ephemeral storage is lost after redeploys.
SNAPSHOT_DIR=snapshots
# Comma-separated Expo Web or deployed web-app origins allowed to call Flask APIs.
MOBILE_WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
SUPERVISOR_JWT_SECRET=replace_with_a_different_32_character_or_longer_secret
SUPERVISOR_JWT_TTL_SECONDS=28800
SUPERVISOR_INITIAL_ADMIN_USERNAME=siteadmin
SUPERVISOR_INITIAL_ADMIN_PASSWORD=change_this_before_starting
SUPERVISOR_INITIAL_ADMIN_NAME=Site Administrator
